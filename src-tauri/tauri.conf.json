{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "绘话",
  "version": "2.0.2",
  "identifier": "com.huihua.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8090",
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "绘话",
        "width": 1440,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost http://localhost:8090 ws://localhost:8090",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/绘话/**",
          "$RESOURCE/resources/presets/**",
          "$RESOURCE/presets/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/presets"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
